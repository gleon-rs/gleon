{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gleon case report (.gleon/runs/latest/cases/<platform>/<name>.json)",
  "description": "One golden comparison.",
  "type": "object",
  "properties": {
    "artifacts": {
      "description": "The images kept for the case: of a failure, or the candidate of a recorded pass against\nanother platform's golden that differs from it.",
      "anyOf": [
        {
          "$ref": "#/$defs/Artifacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate": {
      "description": "The image of this run.",
      "$ref": "#/$defs/CandidateImage"
    },
    "comparison": {
      "description": "How the images were compared.",
      "$ref": "#/$defs/Comparison"
    },
    "error_kind": {
      "description": "Class of an `error` outcome.",
      "anyOf": [
        {
          "$ref": "#/$defs/CaseErrorKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "golden": {
      "description": "The committed golden.",
      "$ref": "#/$defs/GoldenImage"
    },
    "message": {
      "description": "Human-readable detail (failure reason or error).",
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "description": "Whole-image metrics; absent when no pixel comparison ran.",
      "anyOf": [
        {
          "$ref": "#/$defs/Metrics"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "description": "Canonical test name: the golden path relative to the workspace root without extension, as\nlowercase `[a-z0-9_.-]` segments separated by `/`. It is the file name of the report under\nits platform's directory, and the folder of its images; the same on every platform.",
      "type": "string",
      "pattern": "^(?!\\.\\.?(/|$))[a-z0-9_.-]+(/(?!\\.\\.?(/|$))[a-z0-9_.-]+)*$"
    },
    "outcome": {
      "description": "Result of the case.",
      "$ref": "#/$defs/CaseOutcome"
    },
    "platform": {
      "description": "Platform the candidate was rendered on: auto-detected `os` and `arch`, named like in the CLI.\nIts key names the directory of the report and of its images.",
      "$ref": "#/$defs/PlatformConfig"
    },
    "recorded_at": {
      "description": "When the case was recorded (RFC 3339).",
      "type": "string",
      "format": "date-time"
    },
    "regions": {
      "description": "Per-region metrics when `metrics` is present: the whole image, then the worst tile of text\n(when text was compared under a tolerance).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RegionMetrics"
      }
    },
    "run_id": {
      "description": "The run the case belongs to, when the run is named (`GLEON_RUN_ID`).",
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "description": "Version of this format (`CASE_SCHEMA_VERSION`).",
      "type": "integer",
      "format": "uint32",
      "maximum": 3,
      "minimum": 3
    },
    "source": {
      "description": "What produced the candidate.",
      "$ref": "#/$defs/Source"
    },
    "test": {
      "description": "The producing test, when known.",
      "anyOf": [
        {
          "$ref": "#/$defs/TestInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "timings_ms": {
      "description": "Durations.",
      "$ref": "#/$defs/CaseTimings"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "golden",
    "candidate",
    "source",
    "platform",
    "comparison",
    "outcome",
    "regions",
    "timings_ms",
    "recorded_at"
  ],
  "$defs": {
    "Artifacts": {
      "description": "The images of a case, as paths relative to the workspace root (`/`-separated):\n`<artifacts dir>/<platform key>/<name>/{golden,candidate,diff}.png`.\n\n`<artifacts dir>` is an artifacts directory (`.gleon/runs/latest/artifacts` or a directory\nunder `.gleon/runs/` outside `latest/`), the same for every image of the case;\n`<platform key>` is the key of the report's `platform` and `<name>` its `name`, so a report\nlists only its own images.",
      "type": "object",
      "properties": {
        "candidate": {
          "description": "The candidate (mismatches, dimension mismatches, missing goldens and passes against another\nplatform's golden that differ from it, for `gleon approve`):\n`<artifacts dir>/<platform key>/<name>/candidate.png`.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\.gleon/runs/(latest/artifacts|(?![Ll][Aa][Tt][Ee][Ss][Tt](/|$))(?!\\.\\.?(/|$))[A-Za-z0-9._-]+(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+)*)/[a-z0-9_.-]+([+=][a-z0-9_.-]+)*/(?!\\.\\.?(/|$))[a-z0-9_.-]+(/(?!\\.\\.?(/|$))[a-z0-9_.-]+)*/candidate\\.png$"
        },
        "diff": {
          "description": "The diff visualization (mismatches only): `<artifacts dir>/<platform key>/<name>/diff.png`.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\.gleon/runs/(latest/artifacts|(?![Ll][Aa][Tt][Ee][Ss][Tt](/|$))(?!\\.\\.?(/|$))[A-Za-z0-9._-]+(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+)*)/[a-z0-9_.-]+([+=][a-z0-9_.-]+)*/(?!\\.\\.?(/|$))[a-z0-9_.-]+(/(?!\\.\\.?(/|$))[a-z0-9_.-]+)*/diff\\.png$"
        },
        "golden": {
          "description": "A copy of the golden (mismatches and dimension mismatches):\n`<artifacts dir>/<platform key>/<name>/golden.png`.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\.gleon/runs/(latest/artifacts|(?![Ll][Aa][Tt][Ee][Ss][Tt](/|$))(?!\\.\\.?(/|$))[A-Za-z0-9._-]+(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+)*)/[a-z0-9_.-]+([+=][a-z0-9_.-]+)*/(?!\\.\\.?(/|$))[a-z0-9_.-]+(/(?!\\.\\.?(/|$))[a-z0-9_.-]+)*/golden\\.png$"
        }
      },
      "additionalProperties": false
    },
    "CandidateImage": {
      "description": "The image produced by this run.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Height in pixels; absent if the PNG header could not be read.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "sha256": {
          "description": "SHA-256 of the PNG bytes; absent when the integration compared raw pixels and encoded no\nPNG (a pass); a candidate kept in `artifacts` always has it.",
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "description": "Width in pixels; absent if the PNG header could not be read.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CaseErrorKind": {
      "description": "Class of an `error` outcome, so readers tell a broken image from a broken file system or a\nbug without parsing messages.",
      "oneOf": [
        {
          "description": "The integration passed invalid input.",
          "type": "string",
          "const": "invalid_input"
        },
        {
          "description": "`.gleon/gleon.yaml`, an environment override or a golden name is invalid.",
          "type": "string",
          "const": "config"
        },
        {
          "description": "A file could not be read or written.",
          "type": "string",
          "const": "io"
        },
        {
          "description": "An image could not be decoded, is over the analysis budget or could not be encoded.",
          "type": "string",
          "const": "image"
        },
        {
          "description": "A bug in gleon.",
          "type": "string",
          "const": "internal"
        }
      ]
    },
    "CaseOutcome": {
      "description": "Result of the case.",
      "oneOf": [
        {
          "description": "Byte-identical PNGs; decided without decoding, so there are no metrics.",
          "type": "string",
          "const": "identical"
        },
        {
          "description": "Within the tolerance.",
          "type": "string",
          "const": "match"
        },
        {
          "description": "Beyond the tolerance.",
          "type": "string",
          "const": "mismatch"
        },
        {
          "description": "Different image sizes; no pixel comparison was attempted.",
          "type": "string",
          "const": "dimension_mismatch"
        },
        {
          "description": "The golden could not be compared or written: invalid input or config, an I/O, image or\ninternal error (`error_kind`); see `message`.",
          "type": "string",
          "const": "error"
        },
        {
          "description": "The golden was rewritten from the candidate (update mode); nothing was compared.",
          "type": "string",
          "const": "updated"
        },
        {
          "description": "The golden does not exist (a new test without a baseline); nothing was compared.",
          "type": "string",
          "const": "missing"
        }
      ]
    },
    "CaseTimings": {
      "description": "Wall-clock durations in milliseconds.",
      "type": "object",
      "properties": {
        "native": {
          "description": "Time spent in the native engine (decode, compare, encode), when it ran.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "total": {
          "description": "The whole comparison as seen by the integration.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "total"
      ]
    },
    "Comparison": {
      "description": "How the images were compared.",
      "type": "object",
      "properties": {
        "masks": {
          "description": "Ignored zones, applied to both images.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Zone"
          }
        },
        "policy_version": {
          "description": "Version of the engine's tolerant decisions (SSIM, text tiles): `gleon_engine::POLICY_VERSION`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "text_tolerance": {
          "description": "The tolerance of the text regions the integration reported (pixel and exact only);\nabsent when there were none.",
          "anyOf": [
            {
              "$ref": "#/$defs/TextTolerance"
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "description": "The effective tolerance.",
          "$ref": "#/$defs/Tolerance"
        }
      },
      "additionalProperties": false,
      "required": [
        "tolerance",
        "masks",
        "policy_version"
      ]
    },
    "Dimension": {
      "description": "A pixel count, or a percentage of the image size such as \"25%\".",
      "oneOf": [
        {
          "type": "integer",
          "maximum": 4294967295,
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\s*(\\d+|\\d+(\\.\\d+)?\\s*%)\\s*$"
        }
      ]
    },
    "GoldenImage": {
      "description": "The committed golden.",
      "type": "object",
      "properties": {
        "blob": {
          "description": "The content-addressed baseline (`.gleon/blobs/<scheme>/…`) the golden comes from, as in its\nmanifest; absent for goldens committed as image files (the Flutter package).",
          "anyOf": [
            {
              "$ref": "#/$defs/ImageHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback": {
          "description": "The golden compared in place of `path`, which does not exist yet: the shared golden of the\nworkspace (its `fallback_platform`; integrations with per-platform goldens). `sha256`, `width`\nand `height` describe it; `path` is still where `gleon approve` writes, also from a pass,\nwhich keeps its candidate for that.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!\\.\\.?(/|$))[A-Za-z0-9._-]+(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+)*$"
        },
        "height": {
          "description": "Height in pixels; absent if the PNG header could not be read.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "description": "Path relative to the workspace root, `/`-separated, case as on disk.",
          "type": "string",
          "pattern": "^(?!\\.\\.?(/|$))[A-Za-z0-9._-]+(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "description": "SHA-256 of the PNG bytes; absent when the golden does not exist (`missing`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "description": "Width in pixels; absent if the PNG header could not be read.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "ImageHash": {
      "description": "Content hash as `scheme:value`, lowercase, e.g. `sha256:<64 hex digits>`.",
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[a-z0-9_-]+$"
    },
    "Metrics": {
      "description": "Comparison metrics of one image region.",
      "oneOf": [
        {
          "description": "Exact and pixel tolerances.",
          "type": "object",
          "properties": {
            "diff_pixels": {
              "description": "Pixels whose RGBA bytes differ.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "diff_ratio": {
              "description": "`diff_pixels / total_pixels` (0 for an empty image).",
              "type": "number",
              "format": "double"
            },
            "headroom": {
              "description": "`max_diff_ratio - diff_ratio` (exact: `-diff_ratio`); negative means it failed.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "pixel"
            },
            "text": {
              "description": "The text regions, compared under `comparison.text_tolerance` instead (left out of the pixels\nabove); the worst tile is a `text` entry of `regions`.",
              "anyOf": [
                {
                  "$ref": "#/$defs/TextMetrics"
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_pixels": {
              "description": "Pixels compared strictly (masked pixels and text under `comparison.text_tolerance` left out).",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "total_pixels",
            "diff_pixels",
            "diff_ratio",
            "headroom"
          ]
        },
        {
          "description": "SSIM tolerance (values as defined by the engine's `SsimAnalysis`).",
          "type": "object",
          "properties": {
            "changed_pixels": {
              "description": "Pixels whose RGBA bytes differ.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "changed_region": {
              "description": "Bounding box of the changed pixels.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Region"
                },
                {
                  "type": "null"
                }
              ]
            },
            "failing_pixels": {
              "description": "Pixels failing the policy.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "failing_region": {
              "description": "Bounding box of the changed pixels that failed the policy.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Region"
                },
                {
                  "type": "null"
                }
              ]
            },
            "headroom": {
              "description": "Distance to the thresholds; negative means that gate is exceeded.",
              "$ref": "#/$defs/SsimHeadroom"
            },
            "kind": {
              "type": "string",
              "const": "ssim"
            },
            "max_excess": {
              "description": "Largest deviation beyond `color_tolerance` among the failing regions (0 unless the\nenvelope gate failed).",
              "type": "number",
              "format": "double"
            },
            "mean_ssim": {
              "description": "Mean local SSIM; diagnostic only.",
              "type": "number",
              "format": "double"
            },
            "min_ssim": {
              "description": "Lowest local SSIM, gated by `min_similarity`.",
              "type": "number",
              "format": "double"
            },
            "peak_excess": {
              "description": "Largest envelope deviation over the changed pixels, `color_tolerance` not subtracted.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "min_ssim",
            "mean_ssim",
            "max_excess",
            "peak_excess",
            "changed_pixels",
            "failing_pixels",
            "headroom"
          ]
        }
      ]
    },
    "PlatformConfig": {
      "description": "A platform: an opaque key, or structured fields.\n\nIts key names its directories (manifests, case reports, failure images): `<os>-<arch>`\n(`macos-aarch64`), or `os=<os>+arch=<arch>` when the OS or architecture contains `-`\n(`os=ios-sim+arch=arm`), or `<os>` without an architecture; then `+<renderer>`, then\n`+<key>=<value>` per label, sorted by key; all lowercase. An opaque value is its own key, so\n`macos-aarch64` names the same platform as `{os: macos, arch: aarch64}`.",
      "anyOf": [
        {
          "description": "Opaque `[a-z0-9_.-]` platform key.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "description": "Structured platform fields.",
          "$ref": "#/$defs/PlatformFields"
        }
      ]
    },
    "PlatformFields": {
      "description": "A parsed representation of structured platform fields.",
      "type": "object",
      "properties": {
        "arch": {
          "description": "CPU architecture override.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "labels": {
          "description": "Arbitrary key-value label overrides.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "os": {
          "description": "Operating system override.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "renderer": {
          "description": "Renderer identifier override.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": false
    },
    "Region": {
      "description": "An axis-aligned pixel rectangle.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Height in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "description": "Width in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "x": {
          "description": "Left edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "description": "Top edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RegionKind": {
      "description": "Kind of a compared region.",
      "oneOf": [
        {
          "description": "Pixels compared as an image (the whole golden).",
          "type": "string",
          "const": "image"
        },
        {
          "description": "Text compared under `comparison.text_tolerance`: the tile of its text regions with the largest\nshare of differing pixels.",
          "type": "string",
          "const": "text"
        }
      ]
    },
    "RegionMetrics": {
      "description": "Metrics of one region of the golden.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "How the region was compared.",
          "$ref": "#/$defs/RegionKind"
        },
        "metrics": {
          "description": "The region's metrics.",
          "$ref": "#/$defs/Metrics"
        },
        "rect": {
          "description": "Region bounds in golden pixels; absent for the whole image.",
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "metrics"
      ]
    },
    "RunId": {
      "description": "Identifier of the test run (`GLEON_RUN_ID`), shared by its case reports.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "Sha256Hex": {
      "description": "Lowercase hex SHA-256 digest of the PNG bytes.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Source": {
      "description": "What produced the candidate.",
      "type": "object",
      "properties": {
        "renderer": {
          "description": "Renderer identifier, e.g. `flutter-3.47.5`.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "description": "Integration that ran the comparison, e.g. `gleon_flutter`.",
          "type": "string"
        },
        "tool_version": {
          "description": "Version of that integration.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version"
      ]
    },
    "SsimHeadroom": {
      "description": "Distance of SSIM metrics to their thresholds.",
      "type": "object",
      "properties": {
        "color": {
          "description": "`color_tolerance - peak_excess`. Negative does not always fail: small isolated regions\nwith a weak excess are tolerated by the policy.",
          "type": "number",
          "format": "double"
        },
        "similarity": {
          "description": "`min_ssim - min_similarity`.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "similarity",
        "color"
      ]
    },
    "TestInfo": {
      "description": "The test that produced the candidate, when the integration knows it.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Full test name (group names included).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "TextMetrics": {
      "description": "What the text regions of a pixel or exact comparison measured.",
      "type": "object",
      "properties": {
        "diff_pixels": {
          "description": "Text pixels that differ.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "headroom": {
          "description": "`comparison.text_tolerance` minus `worst_tile_diff_ratio`; negative means it failed.",
          "type": "number",
          "format": "double"
        },
        "pixels": {
          "description": "Text pixels (masked ones left out).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "worst_tile_diff_ratio": {
          "description": "Share of differing pixels of the worst tile.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "pixels",
        "diff_pixels",
        "worst_tile_diff_ratio",
